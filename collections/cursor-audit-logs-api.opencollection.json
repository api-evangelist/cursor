{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cursor Admin Audit Logs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cursor.com/teams/audit-logs",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch audit log events with optional filtering by date, event type, and user."
        }
      ]
    }
  ],
  "bundled": true
}